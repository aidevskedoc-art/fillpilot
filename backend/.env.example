# PostgreSQL — the database is created on first start if it doesn't exist.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=pdf_form_db
PGSSL=false

# Random string, at least 32 characters. The server refuses to start without it.
JWT_SECRET=
JWT_EXPIRES_IN=8h

PORT=4100
HOST=0.0.0.0

# Comma-separated browser origins allowed to call the API (dashboard + extension).
# chrome-extension://<id> — the id is fixed by the "key" in extension/manifest.json.
CORS_ORIGIN=http://localhost:4300,chrome-extension://fjikihdjljokehgbcjdccbojpogdmadc

# Uploaded PDFs live here (relative to backend/).
STORAGE_DIR=./storage
# false = delete each PDF as soon as its data has been read (no preview or Retry
# afterwards — upload it again). The extracted data stays until RETENTION_DAYS.
KEEP_PDF=true
MAX_UPLOAD_MB=20
# Documents (file + extracted data) older than this are deleted by the hourly sweep. 0 = keep forever.
# The data is only needed between reading a PDF and filling the form — 1 is enough for that.
RETENTION_DAYS=30

# How ambiguous numeric dates like 10/02/1990 are read: DMY (India, default) or MDY.
DATE_ORDER=DMY

# off | gemini (not implemented yet). Never send real patient data to a free-tier AI API.
AI_PROVIDER=off

# First Admin account, created only when the users table is empty.
# Use a real password (8+ characters) wherever other machines can reach this server.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator

# Serve the synthetic demo target forms at /demo/forms/* (never in production).
DEMO_FORMS=true
